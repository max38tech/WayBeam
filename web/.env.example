# Firebase Web App Configuration (Spark / Free Tier)
# Copy this file to web/.env and fill in your Firebase project values.
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Optional: Local WayBeam Host Agent WebSocket settings
# Must match WAYBEAM_LOCAL_TOKEN in host-agent/.env if set
VITE_WAYBEAM_LOCAL_TOKEN=
VITE_WAYBEAM_AGENT_URL=ws://127.0.0.1:8765
